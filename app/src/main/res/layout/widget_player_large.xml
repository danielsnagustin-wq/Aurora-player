<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111111"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Aurora Player"
        android:textColor="#DCE8F5"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Toca una canción para empezar"
        android:textColor="#9AA7B8"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anterior"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reproducir o pausar"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Siguiente"
            android:src="@android:drawable/ic_media_next" />

    </LinearLayout>

</LinearLayout>
